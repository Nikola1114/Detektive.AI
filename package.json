{
  "name": "detective-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DETECTIVE AI — an interactive noir crime investigation game.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node scripts/dev.mjs --server-only",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "test": "DETECTIVE_AI_DISABLE=1 DETECTIVE_DATA_DIR=data/test node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:e2e": "node tests/e2e/playthrough.mjs e2e-shots && node tests/e2e/generated.mjs e2e-shots"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vite": "^6.3.5"
  }
}
